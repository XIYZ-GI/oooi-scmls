<?xml version="1.0" encoding="utf-8"?>
<!--
  套壳应用的清单。

  这个应用完全离线：模型推理、红石模拟与判定全在同一台设备上完成，因此不声明任何
  网络权限——没有权限就没有后台偷偷上传数据的可能，用户也能从安装说明里看到这一点。
  唯一的对外写入是把导出的结构文件放进系统「下载」目录。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 导出 .mcstructure 到系统下载目录；Android 9 及以下需要显式申请写外部存储。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.McscaiGenerator"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="fullSensor"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
